{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:cms",
    "build": "npm run build:static",
    "start": "npm run start:cms",
    "dev:cms": "FOLIO_MODE=cms FOLIO_DIST_DIR=.next-cms-dev next dev --turbopack --hostname 127.0.0.1",
    "build:cms": "FOLIO_MODE=cms next build --turbopack",
    "start:cms": "FOLIO_MODE=cms next start --hostname 127.0.0.1",
    "build:static": "FOLIO_MODE=static next build --turbopack",
    "preview:static": "node scripts/preview-static.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "node --experimental-strip-types tests/milestone.mjs"
  },
  "dependencies": {
    "next": "^15.5.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
